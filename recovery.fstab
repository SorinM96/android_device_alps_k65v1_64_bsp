erofs     system                           /system         flags=display=erofs
erofs     system_ext                       /system_ext     flags=display=erofs
erofs     product                          /product        flags=display=erofs
erofs     vendor                           /vendor         flags=display=erofs
emmc      /dev/block/by-name/boot          /boot           flags=display=emmc
emmc      /dev/block/by-name/init_boot     /init_boot      flags=display=emmc
f2fs      /dev/block/by-name/userdata      /data           flags=display=f2fs
ext4      /dev/block/by-name/metadata      /metadata       flags=display=ext4
